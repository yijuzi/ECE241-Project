// 360/16 = 20 col; 240/16 = 15 row; 300 tiles total
// 0 - empty; 1 - solid wall; 2 - obstacle  
`default_nettype none


module tile_map (Clock, address, tile_ID);
	input wire Clock;
	input wire [8:0] address;
	output reg [3:0] title_ID;
	
	always @(*) begin
		if (address >= 280 && address < 300)
			tile_ID = 4'd1;
		else 
			tile_ID = 4'd0;
	end
endmodule;
	
	

 