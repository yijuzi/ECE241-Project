PRIVATE: UseDPRAM NUMERIC "1"
PRIVATE: VarWidth NUMERIC "0"
PRIVATE: WIDTH_READ_A NUMERIC "4"
PRIVATE: WIDTH_READ_B NUMERIC "4"
